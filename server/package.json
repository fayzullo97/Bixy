{
  "name": "whiteboard-tutor-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Whiteboard AI Tutor backend — modular monolith (Phase 1: auth + data model)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "reset-student": "tsx src/scripts/reset-student.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",

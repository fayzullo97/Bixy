# ---- Server ----
PORT=3000
CORS_ORIGIN=http://localhost:8081
SESSION_SECRET=replace-with-a-long-random-string   # e.g. `openssl rand -hex 32`
SESSION_TTL_DAYS=30

# ---- Telegram Mini App auth ----
# The app opens INSIDE Telegram (bot menu button / t.me link). Telegram signs the
# WebApp `initData` with the bot token, and the server verifies that HMAC-SHA256
# signature — so the bot token is the only Telegram secret needed. (No Login Widget
# / OIDC anymore: TELEGRAM_BOT_ID / ISSUER / JWKS_URL are retired.)
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Reject initData older than this many seconds (replay guard). Default 24h.
TELEGRAM_INITDATA_MAX_AGE_SEC=86400

# ---- Supabase ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Supabase direct Postgres connection (for running migrations) ----
# Supabase -> Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres

# DEV ONLY — enables /auth/dev-login (Telegram bypass) for local runs. Never set in prod.
ALLOW_DEV_LOGIN=0

# ---- Claude API ----
ANTHROPIC_API_KEY=sk-ant-...
GEN_MODEL=claude-haiku-4-5
TOPIC_ID_MODEL=claude-sonnet-4-6
GRADE_MODEL=claude-haiku-4-5   # fill-in-the-blank grading fallback (§8.11) — a cheap yes/no judgment

# ---- AishaAI TTS — UZBEK narration only (Part 01 §2) ----
# model/mood/speed apply only to the built-in uz (Gulnoza) flow.
AISHA_API_KEY=
AISHA_BASE_URL=https://back.aisha.group
AISHA_MOOD=Neutral
NARRATION_BUCKET=narration

# ---- OpenAI TTS — RUSSIAN + ENGLISH narration (Part 01 §2) ----
# One provider for both: a Russian narration with embedded English grammar terms
# is spoken in a single voice, no vendor seam and no accent on the English terms.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy         # Bixy is gender-ambiguous — keep a neutral voice
OPENAI_TTS_INSTRUCTIONS=       # optional tone steer; empty = model default
